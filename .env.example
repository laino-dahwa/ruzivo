# PostgreSQL connection (web app + `npm run migrate`)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=ruzivo
# Maintenance database used only to create PGDATABASE if it doesn't exist yet.
PGADMINDB=postgres
# Optional: data dir of a local cluster (from embedded-postgres binaries) that
# `npm run dev` starts automatically. Leave unset if you run your own Postgres.
# RUZIVO_DEV_PGDATA=%LOCALAPPDATA%\ruzivo-dev-pgdata
